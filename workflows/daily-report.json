    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet liste = '';\nfor (const item of items) {\n  const ozet = item.json.summary;\n  const saat = new Date(item.json.start.dateTime).toLocaleTimeString('tr-TR', {\n    hour: '2-digit',\n    minute: '2-digit',\n    timeZone: 'Europe/Istanbul'\n  });\n  liste += `• ${ozet} - Saat: ${saat}\\n`;\n}\n\nreturn [{\n  json: {\n    mesaj: `Dear Clinic Manager,\\n\\nHere is your schedule for today:\\n\\n${liste}\\nBest regards.`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
