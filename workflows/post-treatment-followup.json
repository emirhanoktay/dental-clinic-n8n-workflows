        "jsCode": "\nconst items = $input.all();\nconst bugun = new Date();\nbugun.setHours(0, 0, 0, 0);\n\nconst sonuc = [];\n\nfor (const item of items) {\n  const tarihStr = item.json['Tedavi Tarihi'];\n  if (!tarihStr) continue;\n  \n  const parcalar = tarihStr.trim().split('-');\n  const tedaviTarihi = new Date(parcalar[0], parcalar[1] - 1, parcalar[2]);\n  tedaviTarihi.setHours(0, 0, 0, 0);\n  \n  const fark = Math.round((bugun - tedaviTarihi) / (1000 * 60 * 60 * 24));\n  \n  if (fark === 1 || fark === 2 || fark === 3) {\n    sonuc.push({\n      json: {\n        ...item.json,\n        gun: fark\n      }\n    });\n  }\n}\n\nreturn sonuc;"
